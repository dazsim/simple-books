{
  "section": "recipes",
  "template": "simplebooks:recipe",
  "sort": 1025,
  "title": "Bacon Cheeseburger",
  "icon": "morefood:item_burger_bacon_cheese",
  "subtitle": "Built on the assembly board.",
  "ingredients": [
    "minecraft:wheat",
    "minecraft:water_bucket",
    "minecraft:beef",
    "minecraft:milk_bucket",
    "morefood:item_joint_bacon"
  ],
  "tools": [
    "minecraft:crafting_table",
    "morefood:item_pestle_mortar",
    "morefood:item_mixing_bowl",
    "morefood:item_mincer",
    "morefood:item_knife",
    "morefood:item_pot",
    "morefood:item_frying_pan",
    "morefood:block_stove",
    "morefood:block_assembly_board"
  ],
  "need_note": "Tools and Buckets are not consumed",
  "steps": [
    {
      "kind": "craft_shapeless",
      "inputs": [
        "morefood:item_pestle_mortar",
        "minecraft:wheat"
      ],
      "output": "morefood:item_flour"
    },
    {
      "kind": "process",
      "title": "Salt",
      "note": "20 seconds,\nor over a\ncampfire, slower",
      "inputs": [
        "minecraft:water_bucket"
      ],
      "appliance": "morefood:item_pot",
      "on": "morefood:block_stove",
      "output": {
        "item": "morefood:item_salt",
        "count": 2
      }
    },
    {
      "kind": "craft_shapeless",
      "inputs": [
        "morefood:item_mixing_bowl",
        "morefood:item_flour",
        "morefood:item_salt",
        "minecraft:water_bucket"
      ],
      "output": "morefood:item_dough"
    },
    {
      "kind": "craft_shaped",
      "pattern": [
        "A",
        "B"
      ],
      "key": {
        "A": "morefood:item_knife",
        "B": "morefood:item_dough"
      },
      "output": {
        "item": "morefood:item_dough_medium",
        "count": 2
      }
    },
    {
      "kind": "craft_shaped",
      "pattern": [
        "A",
        "B"
      ],
      "key": {
        "A": "morefood:item_knife",
        "B": "morefood:item_dough_medium"
      },
      "output": {
        "item": "morefood:item_dough_small",
        "count": 2
      }
    },
    {
      "kind": "process",
      "title": "Bun",
      "note": "10 seconds,\nin the oven slot,\nor use a Baking Peel",
      "inputs": [
        "morefood:item_dough_small"
      ],
      "appliance": {
        "item": "morefood:block_stove",
        "name": "Stove oven"
      },
      "output": "morefood:item_bun"
    },
    {
      "kind": "craft_shapeless",
      "inputs": [
        "morefood:item_mincer",
        "minecraft:beef"
      ],
      "output": "morefood:item_minced_meat_uncooked"
    },
    {
      "kind": "craft_shapeless",
      "inputs": [
        "morefood:item_knife",
        "morefood:item_minced_meat_uncooked"
      ],
      "output": {
        "item": "morefood:item_beef_patty_uncooked",
        "count": 4
      }
    },
    {
      "kind": "process",
      "title": "Beef Patty",
      "note": "5 seconds,\nfrom the stove\noutput slot",
      "inputs": [
        "morefood:item_beef_patty_uncooked"
      ],
      "appliance": "morefood:item_frying_pan",
      "on": "morefood:block_stove",
      "output": "morefood:item_beef_patty_cooked"
    },
    {
      "kind": "process",
      "title": "Cheese",
      "note": "20 seconds,\nor over a\ncampfire, slower",
      "inputs": [
        "minecraft:milk_bucket"
      ],
      "appliance": "morefood:item_pot",
      "on": "morefood:block_stove",
      "output": "morefood:item_cheese"
    },
    {
      "kind": "craft_shaped",
      "pattern": [
        "A",
        "B"
      ],
      "key": {
        "A": "morefood:item_knife",
        "B": "morefood:item_cheese"
      },
      "output": {
        "item": "morefood:item_cheese_slice",
        "count": 8
      }
    },
    {
      "kind": "craft_shaped",
      "pattern": [
        "A",
        "B"
      ],
      "key": {
        "A": "morefood:item_knife",
        "B": "morefood:item_joint_bacon"
      },
      "output": {
        "item": "morefood:item_bacon_uncooked",
        "count": 8
      }
    },
    {
      "kind": "process",
      "title": "Bacon",
      "note": "5 seconds,\nfrom the stove\noutput slot",
      "inputs": [
        "morefood:item_bacon_uncooked"
      ],
      "appliance": "morefood:item_frying_pan",
      "on": "morefood:block_stove",
      "output": "morefood:item_bacon"
    },
    {
      "kind": "assembly",
      "title": "Build it on the Assembly Board",
      "text": "Use each item on the Assembly Board in this order, then take it off with an empty hand:",
      "image": "morefood:textures/simplebooks/cookbook/board.png",
      "cells": [
        {
          "item": "morefood:item_bun",
          "note": "first"
        },
        {
          "item": "morefood:item_beef_patty_cooked",
          "note": "second"
        },
        {
          "item": "morefood:item_cheese_slice",
          "note": "third"
        },
        {
          "item": "morefood:item_bacon",
          "note": "fourth"
        },
        {
          "item": "morefood:item_bun",
          "note": "fifth"
        },
        {
          "item": "morefood:item_burger_bacon_cheese",
          "note": "done"
        }
      ]
    }
  ]
}
