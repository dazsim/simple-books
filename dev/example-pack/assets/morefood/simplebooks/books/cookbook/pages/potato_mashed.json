{
  "section": "recipes",
  "template": "simplebooks:recipe",
  "sort": 1118,
  "title": "Mashed Potato",
  "icon": "morefood:item_potato_mashed",
  "subtitle": "Put together at the crafting table.",
  "ingredients": [
    "minecraft:potato",
    "minecraft:water_bucket"
  ],
  "tools": [
    "minecraft:crafting_table",
    "morefood:item_mincer",
    "morefood:item_knife",
    "morefood:item_pot",
    "morefood:block_stove"
  ],
  "need_note": "Tools and Buckets are not consumed",
  "steps": [
    {
      "kind": "craft_shapeless",
      "inputs": [
        "morefood:item_knife",
        "minecraft:potato"
      ],
      "output": "morefood:item_potato_peeled"
    },
    {
      "kind": "process",
      "title": "Boiled Potato",
      "note": "15 seconds,\nor over a\ncampfire, slower",
      "inputs": [
        "minecraft:water_bucket",
        "morefood:item_potato_peeled"
      ],
      "appliance": "morefood:item_pot",
      "on": "morefood:block_stove",
      "output": "morefood:item_potato_boiled"
    },
    {
      "kind": "craft_shapeless",
      "inputs": [
        "morefood:item_mincer",
        "morefood:item_potato_boiled"
      ],
      "output": "morefood:item_potato_mashed"
    }
  ]
}
